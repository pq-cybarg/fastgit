FROM ubuntu:22.04
RUN apt-get update && apt-get install -y cmake pkg-config build-essential libssl-dev zlib1g-dev libcurl4-openssl-dev libssh-dev && rm -rf /var/lib/apt/lists/*
COPY . /src
WORKDIR /src
RUN cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build -j$(nproc) && ctest --test-dir build
ENTRYPOINT ["/src/build/src/fastgit-cli"]
